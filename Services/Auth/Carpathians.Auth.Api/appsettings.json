{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "carpathians-auth",
    "Audience": "carpathians-api",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Auth": {
    "EmailTokenLifetimeHours": 3,
    "PublicBaseUrl": "http://localhost:5000",
    "Admin": {
      "UserName": "admin",
      "Email": "admin@carpathians.local"
    }
  }
}
