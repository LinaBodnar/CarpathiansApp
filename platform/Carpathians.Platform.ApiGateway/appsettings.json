{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "aggregator": {
        "ClusterId": "aggregator",
        "Order": -10,
        "Match": { "Path": "/api/aggregator/{**catch-all}" },
        "Metadata": { "Team": "platform", "Version": "v1" }
      },

      "reviews-route-rating": {
        "ClusterId": "reviews",
        "Order": -5,
        "Match": { "Path": "/api/routes/{routeId:long}/rating" },
        "Metadata": { "Team": "reviews", "Version": "v1" }
      },
      "reviews-route-discussions": {
        "ClusterId": "reviews",
        "Order": -5,
        "Match": { "Path": "/api/routes/{routeId:long}/discussions" },
        "Metadata": { "Team": "reviews", "Version": "v1" }
      },
      "reviews-route-name": {
        "ClusterId": "reviews",
        "Order": -5,
        "Match": { "Path": "/api/routes/{routeId:long}/name", "Methods": [ "PUT" ] },
        "MaxRequestBodySize": 65536,
        "Metadata": { "Team": "reviews", "Version": "v1" }
      },
      "reviews-top-rated": {
        "ClusterId": "reviews",
        "Order": -5,
        "Match": { "Path": "/api/routes/top-rated" },
        "Metadata": { "Team": "reviews", "Version": "v1" }
      },
      "reviews": {
        "ClusterId": "reviews",
        "Match": { "Path": "/api/reviews/{**catch-all}" },
        "MaxRequestBodySize": 1048576,
        "Metadata": { "Team": "reviews", "Version": "v1" }
      },
      "reviews-discussions": {
        "ClusterId": "reviews",
        "Match": { "Path": "/api/discussions/{**catch-all}" },
        "MaxRequestBodySize": 1048576,
        "Metadata": { "Team": "reviews", "Version": "v1" }
      },

      "catalog-routes": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/routes/{**catch-all}" },
        "MaxRequestBodySize": 1048576,
        "Metadata": { "Team": "catalog", "Version": "v1" }
      },
      "catalog-regions": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/regions/{**catch-all}" },
        "Metadata": { "Team": "catalog", "Version": "v1" }
      },
      "catalog-points": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/points/{**catch-all}" },
        "MaxRequestBodySize": 1048576,
        "Metadata": { "Team": "catalog", "Version": "v1" }
      },

      "booking-bookings": {
        "ClusterId": "booking",
        "Match": { "Path": "/api/bookings/{**catch-all}" },
        "MaxRequestBodySize": 1048576,
        "Metadata": { "Team": "booking", "Version": "v1" }
      },
      "booking-customers": {
        "ClusterId": "booking",
        "Match": { "Path": "/api/customers/{**catch-all}" },
        "MaxRequestBodySize": 1048576,
        "Metadata": { "Team": "booking", "Version": "v1" }
      },
      "booking-departures": {
        "ClusterId": "booking",
        "Match": { "Path": "/api/departures/{**catch-all}" },
        "MaxRequestBodySize": 1048576,
        "Metadata": { "Team": "booking", "Version": "v1" }
      }
    },

    "Clusters": {
      "aggregator": {
        "HttpRequest": { "ActivityTimeout": "00:01:00" },
        "Destinations": { "d1": { "Address": "http://aggregator" } }
      },
      "booking": {
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "Destinations": { "d1": { "Address": "http://booking-api" } }
      },
      "catalog": {
        "LoadBalancingPolicy": "RoundRobin",
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "Destinations": { "d1": { "Address": "http://catalog-api" } }
      },
      "reviews": {
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "Destinations": { "d1": { "Address": "http://reviews-api" } }
      }
    }
  }
}
