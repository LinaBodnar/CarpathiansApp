<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\..\platform\Carpathians.Platform.ServiceDefaults\Carpathians.Platform.ServiceDefaults.csproj" />
    <ProjectReference Include="..\Carpathians.Catalog.Bll\Carpathians.Catalog.Bll.csproj" />
    <ProjectReference Include="..\Carpathians.Catalog.Dal\Carpathians.Catalog.Dal.csproj" />
    <ProjectReference Include="..\Carpathians.Catalog.Domain\Carpathians.Catalog.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.*">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
  </ItemGroup>

  <!-- Лаб. 06: кеш у пам'яті (L1), Redis через Aspire (L2), gRPC-сервер -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="9.0.9" />
    <PackageReference Include="Aspire.StackExchange.Redis.DistributedCaching" Version="9.5.2" />
    <PackageReference Include="Grpc.AspNetCore" Version="2.76.0" />
  </ItemGroup>

  <!-- gRPC-контракт Каталогу (серверна частина) + спільні типи платформи (DecimalValue) -->
  <ItemGroup>
    <Protobuf Include="Protos\catalog.proto" GrpcServices="Server" AdditionalImportDirs="..\..\platform\Protos" />
    <Protobuf Include="..\..\platform\Protos\common\types.proto" GrpcServices="None" ProtoRoot="..\..\platform\Protos" Link="Protos\common\types.proto" />
    <Compile Include="..\..\platform\Protos\common\DecimalValue.cs" Link="Protos\common\DecimalValue.cs" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
