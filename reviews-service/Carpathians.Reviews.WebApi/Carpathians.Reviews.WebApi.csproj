<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- XML-коментарі контролерів і контрактів потрапляють у Swagger -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <!-- Infrastructure підключено лише для реєстрації залежностей під час старту -->
  <ItemGroup>
    <ProjectReference Include="..\..\platform\Carpathians.Platform.ServiceDefaults\Carpathians.Platform.ServiceDefaults.csproj" />
    <ProjectReference Include="..\Carpathians.Reviews.Application\Carpathians.Reviews.Application.csproj" />
    <ProjectReference Include="..\Carpathians.Reviews.Infrastructure\Carpathians.Reviews.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
  </ItemGroup>

  <!-- Лаб. 06: кеш у пам'яті (L1), Redis через Aspire (L2), gRPC-сервер -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="9.0.9" />
    <PackageReference Include="Aspire.StackExchange.Redis.DistributedCaching" Version="9.5.2" />
    <PackageReference Include="Grpc.AspNetCore" Version="2.76.0" />
  </ItemGroup>

  <!-- gRPC-контракт відгуків (серверна частина) -->
  <ItemGroup>
    <Protobuf Include="Protos\reviews.proto" GrpcServices="Server" />
  </ItemGroup>

</Project>
