<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- XML-коментарі контролерів і контрактів потрапляють у Swagger -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <!-- Infrastructure підключено лише для реєстрації залежностей під час старту -->
  <ItemGroup>
    <ProjectReference Include="..\..\platform\Carpathians.Platform.ServiceDefaults\Carpathians.Platform.ServiceDefaults.csproj" />
    <ProjectReference Include="..\Carpathians.Reviews.Application\Carpathians.Reviews.Application.csproj" />
    <ProjectReference Include="..\Carpathians.Reviews.Infrastructure\Carpathians.Reviews.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
  </ItemGroup>

</Project>
