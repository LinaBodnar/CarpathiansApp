<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Serilog.AspNetCore" Version="10.0.1-dev-02312" />
        <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2"/>
    </ItemGroup>

    <!-- Лаб. 06: кеш у пам'яті (L1), Redis через Aspire (L2), gRPC-сервер -->
    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="9.0.9" />
        <PackageReference Include="Aspire.StackExchange.Redis.DistributedCaching" Version="9.5.2" />
        <PackageReference Include="Grpc.AspNetCore" Version="2.76.0" />
        <!-- gRPC reflection: виклики з Postman/grpcurl без .proto (лише Development) -->
        <PackageReference Include="Grpc.AspNetCore.Server.Reflection" Version="2.76.0" />
    </ItemGroup>

    <!-- gRPC-контракт бронювань (серверна частина) + спільні типи платформи (DecimalValue) -->
    <ItemGroup>
        <Protobuf Include="Protos\booking.proto" GrpcServices="Server" AdditionalImportDirs="..\..\platform\Protos" />
        <Protobuf Include="..\..\platform\Protos\common\types.proto" GrpcServices="None" ProtoRoot="..\..\platform\Protos" Link="Protos\common\types.proto" />
        <Compile Include="..\..\platform\Protos\common\DecimalValue.cs" Link="Protos\common\DecimalValue.cs" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\platform\Carpathians.Platform.ServiceDefaults\Carpathians.Platform.ServiceDefaults.csproj" />
      <ProjectReference Include="..\Carpathians.Booking.Bll\Carpathians.Booking.Bll.csproj" />
      <ProjectReference Include="..\Carpathians.Booking.Dal\Carpathians.Booking.Dal.csproj" />
      <ProjectReference Include="..\Carpathians.Booking.Domain\Carpathians.Booking.Domain.csproj" />
    </ItemGroup>

</Project>
